@model web.Models.SessionModel.AdminResult

<div class="view-admins-layout">
    <div class="view-admins-container">
        <div class="view-admins-header">
            <div class="back-button-container">
                <button class="view-admins-go-back-button"><i class="fa-solid fa-angles-left"></i></button>                
            </div>
            <div class="view-admins-header-text">
                <h3>Admins</h3>
            </div>
        </div>
        
        <div class="view-admins-content">
            <div class="view-admins-table-layout">
                @if (Model.ItemCount > 0)
                {
                    <table class="view-admins-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Admin Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var admin in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <span class="admin-name-text">@admin.Name</span>
                                        <div class="admin-id-tooltip">
                                            <span>@admin.Id</span>
                                        </div>
                                    </td>
                                    <td>@admin.Email</td>
                                    <td>@admin.Role</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div>
                        <span>Some error ocurred while fetching admins! Please try later.</span>
                        @Html.Partial("_NoContent")
                    </div>                    
                }
            </div>            
        </div>
    </div>
</div>