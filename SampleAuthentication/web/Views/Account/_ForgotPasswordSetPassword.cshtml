@model web.Models.ForgotPassword

<div class="form_setPassword_container">
    <div class="form_newPassword_container">
        @Html.LabelFor(formModel => formModel.SetPassword_Field.NewPassword, new { @class = "form_newPassword_label" })
        <div class="form_newPassword_input">
            @Html.PasswordFor(formModel => formModel.SetPassword_Field.NewPassword, new { id = "set_newPassword_input" })
            <i class="fa-solid fa-eye" id="set_newPassword_show"
               onclick="showPassword('setNewPassword')"></i>
            <i class="fa-solid fa-eye-slash" id="set_newPassword_hide"
               onclick="hidePassword('setNewPassword')"></i>
        </div>
        <p>@Html.ValidationMessageFor(formModel => formModel.SetPassword_Field.NewPassword)</p>
    </div>

    <div class="form_confirmPassword_container">
        @Html.LabelFor(formModel => formModel.SetPassword_Field.ConfirmPassword, new { @class = "form_confirmPassword_label" })
        <div class="form_confirmPassword_input">
            @Html.TextBoxFor(formModel => formModel.SetPassword_Field.ConfirmPassword, new { autocomplete = "off", id = "set_confirmPassword_input" })
        </div>
        <p>@Html.ValidationMessageFor(formModel => formModel.SetPassword_Field.ConfirmPassword)</p>
    </div>
</div>
