﻿@model web.Models.ForgotPassword

<div class="form_otp_container">
    @Html.LabelFor(formModel => formModel.OTP_Field.OTP, new { @class = "form_otp_label" })
    <div class="form_otp_input">
        @Html.TextBoxFor(formModel => formModel.OTP_Field.OTP, new { autocomplete = "off", style = "text-align: center;" })
    </div>
    <p>@Html.ValidationMessageFor(formModel => formModel.OTP_Field.OTP)</p>
</div>
