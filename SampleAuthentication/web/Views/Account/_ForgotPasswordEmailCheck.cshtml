﻿@model web.Models.ForgotPassword

<div class="form_userEmail_container">
    @Html.LabelFor(formModel => formModel.Email_Field.Email, new { @class = "form_userEmail_label" })
    <div class="form_userEmail_input">
        @Html.TextBoxFor(formModel => formModel.Email_Field.Email, new { autocomplete = "off", type = "email" })
    </div>
    <p>@Html.ValidationMessageFor(formModel => formModel.Email_Field.Email)</p>
</div>
