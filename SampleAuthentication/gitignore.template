# .gitignore Template for Team Members
# This file shows examples of files that should never be committed

# ===================================
# NEVER COMMIT THESE FILE TYPES
# ===================================

# Sensitive Configuration Files
appsettings.Development.json     # Contains development secrets
appsettings.Staging.json         # Contains staging secrets
appsettings.Production.json      # Contains production secrets
connectionstrings.config         # Database connection strings
Web.Staging.config              # Web config transforms with secrets
Web.Production.config           # Web config transforms with secrets

# Environment Variables
.env                            # Environment configuration
.env.local                      # Local environment overrides
.env.production                 # Production environment variables

# Security Keys
*.pfx                          # Certificate files
*.key                          # Private keys
*.pem                          # PEM certificates
jwtkey.json                    # JWT signing keys

# User-Specific Files
*.user                         # Visual Studio user settings
*.suo                          # Visual Studio solution user options
.vs/                          # Visual Studio cache

# Build Outputs
bin/                          # Binary outputs
obj/                          # Object files
publish/                      # Published applications
release/                      # Release builds

# Logs
Logs/                         # Application logs
*.log                         # All log files
web/App_Data/Logs/           # MVC web logs
API_Service/Logs/            # API logs

# Database Files
*.mdf                         # SQL Server database
*.ldf                         # SQL Server log file

# IDE Specific
.vscode/settings.json.user    # VS Code user settings
.idea/                        # JetBrains Rider

# Test Results
TestResults/                  # Test execution results
coverage/                     # Code coverage reports

# ===================================
# FILES YOU SHOULD COMMIT
# ===================================

# ? appsettings.json (without secrets)
# ? Web.config (without secrets)
# ? .csproj files
# ? .cs source files
# ? README.md
# ? .github/workflows/*.yml
# ? Template files (*.template)

# ===================================
# BEST PRACTICES
# ===================================

# 1. Use User Secrets for local development
#    dotnet user-secrets init
#    dotnet user-secrets set "JwtConfig:Key" "your-secret-key"

# 2. Use Azure Key Vault for production secrets

# 3. Use GitHub Secrets for CI/CD variables
#    Settings ? Secrets and variables ? Actions

# 4. Always review before committing:
#    git status
#    git diff

# 5. If you accidentally commit secrets:
#    - Rotate all exposed secrets immediately
#    - Use git-filter-branch or BFG Repo-Cleaner
#    - Force push after cleaning history
